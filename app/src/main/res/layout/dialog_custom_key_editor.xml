<?xml version="1.0" encoding="utf-8"?>
<!-- Custom key editor: name, the recorded combination with the built-in keyboard as its recorder, the sticky option and the icon choice -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="4dp"
        android:paddingRight="24dp"
        android:paddingBottom="8dp">

        <EditText
            style="@style/Widget.SuperArtemis.TextField"
            android:id="@+id/custom_key_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/custom_key_name_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="24"
            android:minHeight="48dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/custom_key_keys_label"
            android:textAppearance="@style/TextAppearance.SuperArtemis.SectionLabel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/custom_key_combo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_preview_frame"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="@string/custom_key_combo_hint"
                android:minHeight="48dp"
                android:paddingLeft="12dp"
                android:paddingTop="10dp"
                android:paddingRight="12dp"
                android:paddingBottom="10dp"
                android:textAppearance="@style/TextAppearance.SuperArtemis.BodyLarge" />

            <ImageButton
                android:id="@+id/custom_key_backspace"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/bg_button_text"
                android:contentDescription="@string/custom_key_remove_last"
                android:src="@drawable/ic_gm_backspace" />
        </LinearLayout>

        <!-- The recorder keyboard sits right under the key box, so recording a combination needs no scrolling -->
        <FrameLayout
            android:id="@+id/custom_key_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <Switch
            style="@style/Widget.SuperArtemis.Switch"
            android:id="@+id/custom_key_sticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/custom_key_sticky" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/custom_key_icon_label"
            android:textAppearance="@style/TextAppearance.SuperArtemis.SectionLabel" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/custom_key_icons"
            android:layout_width="match_parent"
            android:layout_height="232dp"
            android:layout_marginTop="4dp"
            android:scrollbars="vertical" />
    </LinearLayout>
</ScrollView>
