<?xml version="1.0" encoding="utf-8"?>
<!-- Special key editor: name, the steps it runs in order with chips to add one, the key recorder for Keys, Hold and Release steps, the sticky option and the icon -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="4dp"
        android:paddingRight="24dp"
        android:paddingBottom="8dp">

        <EditText
            style="@style/Widget.SuperArtemis.TextField"
            android:id="@+id/custom_key_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/custom_key_name_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="24"
            android:minHeight="48dp"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/custom_key_steps_label"
            android:textAppearance="@style/TextAppearance.SuperArtemis.SectionLabel" />

        <TextView
            android:id="@+id/custom_key_steps_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/custom_key_steps_empty"
            android:textAppearance="@style/TextAppearance.SuperArtemis.BodyMedium" />

        <LinearLayout
            android:id="@+id/custom_key_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/custom_key_add_step"
            android:textAppearance="@style/TextAppearance.SuperArtemis.SectionLabel" />

        <com.limelight.ui.FlowRow
            android:id="@+id/custom_key_add_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:rowGap="0dp" />

        <!-- The recorder opens for a Keys, Hold or Release step and closes with Done, so the editor stays short otherwise -->
        <LinearLayout
            android:id="@+id/custom_key_recorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/custom_key_recorder_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/custom_key_record_title_combo"
                android:textAppearance="@style/TextAppearance.SuperArtemis.SectionLabel" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/custom_key_combo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_preview_frame"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:hint="@string/custom_key_combo_hint"
                    android:minHeight="48dp"
                    android:paddingLeft="12dp"
                    android:paddingTop="10dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="10dp"
                    android:textAppearance="@style/TextAppearance.SuperArtemis.BodyLarge" />

                <ImageButton
                    android:id="@+id/custom_key_backspace"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/bg_button_text"
                    android:contentDescription="@string/custom_key_remove_last"
                    android:src="@drawable/ic_gm_backspace" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/custom_key_keyboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/custom_key_record_cancel"
                    style="@style/Widget.SuperArtemis.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/game_menu_cancel" />

                <Button
                    android:id="@+id/custom_key_record_done"
                    style="@style/Widget.SuperArtemis.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/custom_key_record_done" />
            </LinearLayout>
        </LinearLayout>

        <Switch
            style="@style/Widget.SuperArtemis.Switch"
            android:id="@+id/custom_key_sticky"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp"
            android:text="@string/custom_key_sticky" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/custom_key_hotkey_label"
            android:textAppearance="@style/TextAppearance.SuperArtemis.SectionLabel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/custom_key_hotkey_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/custom_key_hotkey_none"
                android:textAppearance="@style/TextAppearance.SuperArtemis.BodyLarge" />

            <Button
                android:id="@+id/custom_key_hotkey_clear"
                style="@style/Widget.SuperArtemis.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/custom_key_hotkey_clear" />

            <Button
                android:id="@+id/custom_key_hotkey_set"
                style="@style/Widget.SuperArtemis.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/custom_key_hotkey_set" />
        </LinearLayout>

        <TextView
            android:id="@+id/custom_key_hotkey_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/custom_key_hotkey_hint"
            android:textAppearance="@style/TextAppearance.SuperArtemis.BodySmall" />

        <Switch
            style="@style/Widget.SuperArtemis.Switch"
            android:id="@+id/custom_key_hotkey_to_pc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/custom_key_hotkey_to_pc" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/custom_key_icon_label"
            android:textAppearance="@style/TextAppearance.SuperArtemis.SectionLabel" />

        <EditText
            style="@style/Widget.SuperArtemis.TextField"
            android:id="@+id/custom_key_icon_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/icon_search_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="24"
            android:minHeight="48dp"
            android:singleLine="true" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/custom_key_icons"
            android:layout_width="match_parent"
            android:layout_height="232dp"
            android:layout_marginTop="4dp"
            android:scrollbars="vertical" />
    </LinearLayout>
</ScrollView>
