<?xml version="1.0" encoding="utf-8"?>
<!-- One step of a special key: its icon and description, tap to edit, and buttons to move or delete it -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="4dp">

    <TextView
        android:id="@+id/step_number"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.SuperArtemis.BodySmall" />

    <ImageView
        android:id="@+id/step_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="14dp"
        android:importantForAccessibility="no"
        android:tint="?attr/saPrimary" />

    <TextView
        android:id="@+id/step_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.SuperArtemis.BodyLarge" />

    <ImageButton
        android:id="@+id/step_up"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_button_text"
        android:contentDescription="@string/custom_key_step_move_up"
        android:src="@drawable/ic_ck_arrow_upward"
        android:tint="?attr/saOnSurfaceVariant" />

    <ImageButton
        android:id="@+id/step_down"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_button_text"
        android:contentDescription="@string/custom_key_step_move_down"
        android:src="@drawable/ic_ck_arrow_downward"
        android:tint="?attr/saOnSurfaceVariant" />

    <ImageButton
        android:id="@+id/step_delete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_button_text"
        android:contentDescription="@string/custom_key_step_delete"
        android:src="@drawable/ic_sa_delete"
        android:tint="?attr/saOnSurfaceVariant" />
</LinearLayout>
