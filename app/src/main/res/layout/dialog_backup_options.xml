<?xml version="1.0" encoding="utf-8"?>
<!-- Backup dialog body: one-line summary, the pairing keys opt-in, its benefit, and the caution in red right below it -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingTop="4dp"
    android:paddingRight="24dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/backup_dialog_summary"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/backup_include_keys"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="48dp"
        android:text="@string/backup_include_pairing_keys"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="32dp"
        android:text="@string/backup_keys_benefit"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="32dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_gm_warning" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/backup_keys_caution"
            android:textColor="@color/backup_caution"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
