<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides the search library's result row: each result is a rounded card with its section name in the primary color, like the cards of Settings -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginTop="4dp"
    android:layout_marginRight="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_card_clickable"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="14dp"
    android:paddingRight="20dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/breadcrumbs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:textAppearance="@style/TextAppearance.SuperArtemis.BodySmall"
        android:textColor="?attr/saPrimary" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.SuperArtemis.TitleMedium"
        android:textColor="?attr/saOnSurface" />

    <TextView
        android:id="@+id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.SuperArtemis.BodyMedium"
        android:textColor="?attr/saOnSurfaceVariant" />
</LinearLayout>
