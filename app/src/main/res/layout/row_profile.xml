<?xml version="1.0" encoding="utf-8"?>
<!-- One profile as a rounded card: drag handle, name and last change, then the active radio and the copy, edit and delete buttons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_clickable"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/profileDragHandle"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="@string/game_menu_editor_drag"
        android:scaleType="center"
        android:src="@drawable/ic_sa_drag_indicator"
        android:tint="?attr/saOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/profileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.SuperArtemis.TitleMedium"
            android:textColor="?attr/saOnSurface" />

        <TextView
            android:id="@+id/profileTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.SuperArtemis.BodySmall"
            android:textColor="?attr/saOnSurfaceVariant" />
    </LinearLayout>

    <RadioButton
        android:id="@+id/profileActive"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:buttonTint="?attr/saPrimary"
        android:contentDescription="@string/profile_manager_set_active" />

    <ImageButton
        android:id="@+id/copyProfile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_button_text"
        android:contentDescription="@string/profile_manager_copy"
        android:src="@drawable/ic_sa_content_copy"
        android:tint="?attr/saOnSurfaceVariant" />

    <ImageButton
        android:id="@+id/editProfile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_button_text"
        android:contentDescription="@string/profile_manager_edit"
        android:src="@drawable/ic_sa_edit"
        android:tint="?attr/saOnSurfaceVariant" />

    <ImageButton
        android:id="@+id/deleteProfile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_button_text"
        android:contentDescription="@string/profile_manager_delete_profile"
        android:src="@drawable/ic_sa_delete"
        android:tint="?attr/saOnSurfaceVariant" />

</LinearLayout>
