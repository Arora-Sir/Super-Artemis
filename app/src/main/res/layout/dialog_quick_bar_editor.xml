<?xml version="1.0" encoding="utf-8"?>
<!-- Quick-action bar editor: a screen preview with four corners to pick from, the direction of the picked corner, then its items -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_bar_panes"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp">

    <LinearLayout
        android:id="@+id/quick_bar_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/quick_bar_preview"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sa_quick_bar_preview_height"
            android:background="@drawable/bg_preview_screen"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/quick_bar_slot_top_left"
                style="@style/SuperArtemis.CornerSlot"
                android:layout_gravity="top|start" />

            <LinearLayout
                android:id="@+id/quick_bar_slot_top_right"
                style="@style/SuperArtemis.CornerSlot"
                android:layout_gravity="top|end" />

            <LinearLayout
                android:id="@+id/quick_bar_slot_bottom_left"
                style="@style/SuperArtemis.CornerSlot"
                android:layout_gravity="bottom|start" />

            <LinearLayout
                android:id="@+id/quick_bar_slot_bottom_right"
                style="@style/SuperArtemis.CornerSlot"
                android:layout_gravity="bottom|end" />

            <TextView
                android:id="@+id/quick_bar_preview_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:paddingLeft="56dp"
                android:paddingRight="56dp"
                android:textAppearance="@style/TextAppearance.SuperArtemis.BodySmall" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/quick_bar_direction"
            android:textAppearance="@style/TextAppearance.SuperArtemis.SectionLabel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quick_bar_direction_row"
                style="@style/SuperArtemis.Segment"
                android:layout_marginRight="8dp"
                android:text="@string/quick_bar_direction_row" />

            <TextView
                android:id="@+id/quick_bar_direction_column"
                style="@style/SuperArtemis.Segment"
                android:text="@string/quick_bar_direction_column" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/quick_bar_editor_hint"
            android:textAppearance="@style/TextAppearance.SuperArtemis.BodySmall" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quick_bar_items_pane"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/quick_bar_items_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="@style/TextAppearance.SuperArtemis.SectionLabel" />

        <FrameLayout
            android:id="@+id/quick_bar_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
