<?xml version="1.0" encoding="utf-8"?>
<!-- One choice in a picker list: icon, label and a check mark on the current choice -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingRight="16dp">

    <ImageView
        android:id="@+id/sa_choice_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:tint="?attr/saOnSurfaceVariant" />

    <TextView
        android:id="@+id/sa_choice_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.SuperArtemis.BodyLarge" />

    <ImageView
        android:id="@+id/sa_choice_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_sa_check"
        android:tint="?attr/saPrimary" />
</LinearLayout>
