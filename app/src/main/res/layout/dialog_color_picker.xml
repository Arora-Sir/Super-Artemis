<?xml version="1.0" encoding="utf-8"?>
<!-- Custom accent color: a saturation and value square with a hue bar, the hex code, and the color on black and on a card -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="8dp">

        <com.limelight.theme.HsvPickerView
            android:id="@+id/color_picker_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/color_picker_hex"
                style="@style/Widget.SuperArtemis.TextField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:digits="0123456789abcdefABCDEF#"
                android:hint="@string/color_picker_hex_hint"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="7"
                android:singleLine="true" />

            <Button
                android:id="@+id/color_picker_reset"
                style="@style/Widget.SuperArtemis.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/color_picker_reset" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/color_picker_on_black"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/color_picker_preview_black"
                android:textAppearance="@style/TextAppearance.SuperArtemis.TitleSmall" />

            <TextView
                android:id="@+id/color_picker_on_card"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/color_picker_preview_card"
                android:textAppearance="@style/TextAppearance.SuperArtemis.TitleSmall" />
        </LinearLayout>

        <TextView
            android:id="@+id/color_picker_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.SuperArtemis.BodySmall" />
    </LinearLayout>
</ScrollView>
