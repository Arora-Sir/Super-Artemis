<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: a sticky search bar, an optional section list on wide screens, the settings list, and an overlay for the search page -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/saBackground"
    tools:context=".preferences.StreamSettings">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/settings_search_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_search_bar"
            android:clickable="true"
            android:contentDescription="@string/search_settings_hint"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sa_search"
                android:tint="?attr/saOnSurfaceVariant" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:text="@string/search_settings_hint"
                android:textAppearance="@style/TextAppearance.SuperArtemis.BodyLarge"
                android:textColor="?attr/saOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/settings_sections"
                android:layout_width="264dp"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingLeft="12dp"
                android:paddingBottom="16dp"
                android:scrollbars="none"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/stream_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/settings_search_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
