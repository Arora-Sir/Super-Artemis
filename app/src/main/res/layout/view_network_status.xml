<?xml version="1.0" encoding="utf-8"?>
<!-- Connection status card at the top of the stream: a dropped network while the stream still waits, and the automatic reconnect after it ended -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/networkStatusCard"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|center_horizontal"
    android:layout_marginStart="24dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="24dp"
    android:background="@drawable/bg_network_status"
    android:minWidth="280dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    android:preferKeepClear="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/networkStatusIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ck_wifi_off"
            android:tint="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/networkStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SuperArtemis.TitleSmall"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:id="@+id/networkStatusDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.SuperArtemis.BodyMedium"
                android:textColor="#B3FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/networkStatusProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:indeterminateTint="#FF8AB4F8" />

    <LinearLayout
        android:id="@+id/networkStatusActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/networkStatusCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="64dp"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/network_resume_cancel"
            android:textAppearance="@style/TextAppearance.SuperArtemis.BodyMedium"
            android:textColor="#B3FFFFFF" />

        <TextView
            android:id="@+id/networkStatusNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="64dp"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/network_resume_now"
            android:textAppearance="@style/TextAppearance.SuperArtemis.BodyMedium"
            android:textColor="#FF8AB4F8" />
    </LinearLayout>
</LinearLayout>
