<?xml version="1.0" encoding="utf-8"?>
<!-- One-line dialog title for the large editors: a small tonal icon circle, then the headline -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="24dp"
    android:paddingTop="20dp"
    android:paddingRight="24dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/sa_dialog_compact_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icon_circle"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:tint="?attr/saOnSecondaryContainer" />

    <TextView
        android:id="@+id/sa_dialog_compact_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.SuperArtemis.Headline"
        android:textColor="?attr/saOnSurface" />
</LinearLayout>
