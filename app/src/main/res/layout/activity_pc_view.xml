<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen in both orientations: a top bar with the app name and round tonal buttons for help, Settings and adding a PC, then the PC grid and the profiles button. Colors come from the app style roles. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/saBackground"
    tools:context=".PcView">

    <LinearLayout
        android:id="@+id/homeTopBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/home_title"
            android:textAppearance="@style/TextAppearance.SuperArtemis.Headline"
            android:textColor="?attr/saOnSurface" />

        <ImageButton
            android:id="@+id/helpButton"
            style="@style/SuperArtemis.HomeIconButton"
            android:contentDescription="@string/home_help"
            android:src="@drawable/ic_sa_help" />

        <ImageButton
            android:id="@+id/settingsButton"
            style="@style/SuperArtemis.HomeIconButton"
            android:contentDescription="@string/home_settings"
            android:src="@drawable/ic_sa_settings" />

        <ImageButton
            android:id="@+id/manuallyAddPc"
            style="@style/SuperArtemis.HomeIconButton"
            android:contentDescription="@string/home_add_pc"
            android:src="@drawable/ic_sa_add" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/homeTopBar"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingRight="@dimen/activity_horizontal_margin">

            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/searching_pc"
                android:textAppearance="@style/TextAppearance.SuperArtemis.TitleMedium"
                android:textColor="?attr/saOnSurface" />
        </LinearLayout>
    </RelativeLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/profilesButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:contentDescription="@string/profile_manager_choose_profile"
        app:icon="@drawable/ic_profiles" />

</RelativeLayout>
