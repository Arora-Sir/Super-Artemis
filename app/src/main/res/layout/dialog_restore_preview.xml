<?xml version="1.0" encoding="utf-8"?>
<!-- Restore preview body: where the backup came from, a tick for every part it holds, settings this device cannot use, and what happens to the PCs -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/restore_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.SuperArtemis.BodyMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/restore_choose_parts"
            android:textAppearance="@style/TextAppearance.SuperArtemis.SectionLabel" />

        <LinearLayout
            android:id="@+id/restore_parts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="4dp" />

        <TextView
            android:id="@+id/restore_issues_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/restore_device_issues"
            android:textAppearance="@style/TextAppearance.SuperArtemis.SectionLabel"
            android:visibility="gone" />

        <TextView
            android:id="@+id/restore_issues_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/restore_device_issues_hint"
            android:textAppearance="@style/TextAppearance.SuperArtemis.BodySmall"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/restore_issues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="4dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/restore_outcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_safe_callout"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/restore_outcome_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="1dp"
                android:layout_marginRight="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_gm_check_circle" />

            <TextView
                android:id="@+id/restore_outcome_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:textAppearance="@style/TextAppearance.SuperArtemis.BodyMedium"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/restore_preview_note"
            android:textAppearance="@style/TextAppearance.SuperArtemis.BodySmall" />
    </LinearLayout>
</ScrollView>
