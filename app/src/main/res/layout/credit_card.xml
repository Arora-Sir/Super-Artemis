<?xml version="1.0" encoding="utf-8"?>
<!-- One credit: what was used, who made it with links to their profiles, and chips for every PR, commit or issue -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/credit_feature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.SuperArtemis.TitleMedium" />

    <TextView
        android:id="@+id/credit_people"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.SuperArtemis.BodyMedium"
        android:textColorLink="?attr/saPrimary" />

    <com.limelight.ui.FlowRow
        android:id="@+id/credit_links"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp" />
</LinearLayout>
