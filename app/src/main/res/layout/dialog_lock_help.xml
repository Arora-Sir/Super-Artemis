<?xml version="1.0" encoding="utf-8"?>
<!-- Lock key help: why the PC may ignore Win+L, the host script to save, and where to put it -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_help_steps"
            android:textAppearance="@style/TextAppearance.SuperArtemis.BodyMedium" />

        <TextView
            android:id="@+id/lock_help_script"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:textAppearance="@style/TextAppearance.SuperArtemis.BodyMedium"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/lock_help_after"
            android:textAppearance="@style/TextAppearance.SuperArtemis.BodySmall" />
    </LinearLayout>
</ScrollView>
