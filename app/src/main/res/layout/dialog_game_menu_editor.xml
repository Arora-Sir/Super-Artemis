<?xml version="1.0" encoding="utf-8"?>
<!-- Menu editor body: style picker, hint, then the reorderable action list and a live preview, side by side on wide screens -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/game_menu_editor_style"
        android:textAppearance="@style/TextAppearance.SuperArtemis.SectionLabel" />

    <LinearLayout
        android:id="@+id/game_menu_editor_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/game_menu_editor_style_list"
            style="@style/SuperArtemis.Segment"
            android:layout_marginRight="8dp"
            android:text="@string/game_menu_style_list" />

        <TextView
            android:id="@+id/game_menu_editor_style_grid"
            style="@style/SuperArtemis.Segment"
            android:layout_marginRight="8dp"
            android:text="@string/game_menu_segment_grid" />

        <TextView
            android:id="@+id/game_menu_editor_style_compact"
            style="@style/SuperArtemis.Segment"
            android:text="@string/game_menu_style_compact" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:text="@string/game_menu_editor_hint"
        android:textAppearance="@style/TextAppearance.SuperArtemis.BodySmall" />

    <LinearLayout
        android:id="@+id/game_menu_editor_panes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/game_menu_editor_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/game_menu_editor_preview_pane"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:text="@string/game_menu_editor_preview"
                android:textAppearance="@style/TextAppearance.SuperArtemis.SectionLabel" />

            <FrameLayout
                android:id="@+id/game_menu_editor_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_preview_screen"
                android:padding="4dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
