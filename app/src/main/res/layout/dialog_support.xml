<?xml version="1.0" encoding="utf-8"?>
<!-- Support development: a UPI card (QR, ID with copy, open a UPI app) and a PayPal card. It only opens from About, never as a prompt. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/support_upi_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="@dimen/sa_support_qr_size"
                android:layout_height="@dimen/sa_support_qr_size"
                android:background="@drawable/bg_qr"
                android:contentDescription="@string/support_qr_description"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/support_upi_qr" />

            <LinearLayout
                android:id="@+id/support_upi_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/support_upi_title"
                    android:textAppearance="@style/TextAppearance.SuperArtemis.TitleMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/support_qr_caption"
                    android:textAppearance="@style/TextAppearance.SuperArtemis.BodyMedium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/support_upi_id"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.SuperArtemis.BodyLarge" />

                    <ImageButton
                        android:id="@+id/support_copy_upi"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_button_text"
                        android:contentDescription="@string/support_copy"
                        android:src="@drawable/ic_sa_content_copy"
                        android:tint="?attr/saPrimary" />
                </LinearLayout>

                <Button
                    android:id="@+id/support_upi_app"
                    style="@style/Widget.SuperArtemis.Button.Filled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/support_pay_upi_app" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/support_paypal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_clickable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_sa_payments"
                android:tint="?attr/saOnSecondaryContainer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/support_paypal"
                    android:textAppearance="@style/TextAppearance.SuperArtemis.TitleMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/support_paypal_summary"
                    android:textAppearance="@style/TextAppearance.SuperArtemis.BodyMedium" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sa_open_in_new"
                android:tint="?attr/saOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/support_sponsors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_clickable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_brand_github"
                android:tint="?attr/saOnSecondaryContainer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/support_sponsors"
                    android:textAppearance="@style/TextAppearance.SuperArtemis.TitleMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/support_sponsors_summary"
                    android:textAppearance="@style/TextAppearance.SuperArtemis.BodyMedium" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sa_open_in_new"
                android:tint="?attr/saOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
