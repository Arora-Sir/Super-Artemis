<?xml version="1.0" encoding="utf-8"?>
<!-- One half of a two-choice segmented button: tonal fill while selected -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="?attr/saSecondaryContainer" />
                    <stroke
                        android:width="1dp"
                        android:color="?attr/saOutline" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <stroke
                        android:width="1dp"
                        android:color="?attr/saOutline" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
