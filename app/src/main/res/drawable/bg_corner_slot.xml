<?xml version="1.0" encoding="utf-8"?>
<!-- A corner in the quick-action bar preview: outlined in the accent color while selected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="?attr/saSecondaryContainer" />
            <stroke
                android:width="2dp"
                android:color="?attr/saPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/saOutlineVariant"
                android:dashWidth="4dp"
                android:dashGap="3dp" />
        </shape>
    </item>
</selector>
