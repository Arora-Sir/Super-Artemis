<?xml version="1.0" encoding="utf-8"?>
<!-- Text field: a rounded filled box that gains a primary outline while focused, in place of the classic underline -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="?attr/saSurfaceContainerHighest" />
            <stroke android:width="2dp" android:color="?attr/saPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="?attr/saSurfaceContainerHighest" />
            <stroke android:width="1dp" android:color="?attr/saOutlineVariant" />
        </shape>
    </item>
</selector>
