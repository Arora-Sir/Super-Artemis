<?xml version="1.0" encoding="utf-8"?>
<!-- Switch side of a two-target settings row: a short vertical divider on its start edge and a ripple over the switch area -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="14dp"
        android:gravity="start|fill_vertical"
        android:top="14dp"
        android:width="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/saOutlineVariant" />
        </shape>
    </item>
    <item android:drawable="?android:attr/selectableItemBackgroundBorderless" />
</layer-list>
